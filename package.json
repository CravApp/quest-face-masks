{
  "name": "quest-face-masks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs && node scripts/fetch-model.mjs",
    "dev": "vite",
    "predev:lan": "node scripts/copy-wasm.mjs && node scripts/fetch-model.mjs",
    "dev:lan": "vite --mode lan",
    "chii": "chii start -p 8080 --base-path /__chii",
    "prebuild": "node scripts/copy-wasm.mjs && node scripts/fetch-model.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "chii": "^1.15.5",
    "selfsigned": "^5.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
